# Infernaut loads this file automatically when it sits beside infernaut.toml.
# Existing exported variables override values here. Keep this file private.

# Required by [server].api_key_env in infernaut.toml.
# Generate a long random value; clients must send the same value.
INFERNAUT_API_KEY=

# Optional named inference clients used by the live observer.
INFERNAUT_CLAUDE_CODE_KEY=
INFERNAUT_HERMES_KEY=

# Optional Claude Code recipe ID built in the configuration TUI.
# INFERNAUT_CLAUDE_RECIPE=claude-lab
# INFERNAUT_CLAUDE_ENABLE_1M_CONTEXT=1

# Required only when the Ollama Cloud provider is enabled.
OLLAMA_API_KEY=

# Optional logging override.
RUST_LOG=infernaut=info
